{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio of Darpan Radadiya \u2014 data / analytics engineer",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:mono": "tsx scripts/check-mono-subset.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run lint:mono && npm run lint:fonts && npm run format:check && npm run test && npm run build && npm run lint:todo",
    "lint:fonts": "python3 scripts/check-fonts.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-stats": "tsx scripts/fetch-stats.ts",
    "test:e2e": "playwright test",
    "lint:todo": "node scripts/check-no-todo.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "15.5.25",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
